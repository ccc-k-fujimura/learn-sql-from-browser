---
import '../styles/global.css';

// title を省くと、ページの題はサイト名だけになる
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{title ? `${title} | ブラウザで学ぶ SQL` : 'ブラウザで学ぶ SQL'}</title>
  </head>
  <body>
    <slot name="banner" />
    <main class="mx-auto max-w-[860px] px-4 pt-6 pb-16">
      <slot />
    </main>
  </body>
</html>
