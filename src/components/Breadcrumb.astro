---
import type { Level } from '../levels';

interface Props {
  level: Level;
  /** レベルのページそのものなら、レベル名をリンクにしない */
  here?: boolean;
}

// パンくず（トップ › レベル）。レベルのページ、レッスンのページ、修了のページで使う
const { level, here = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav aria-label="パンくずリスト" class="text-[.9rem] text-muted">
  <a href={`${base}/`}>トップ</a> › {here ? <span aria-current="page">{level.name}</span> : <a href={`${base}/${level.id}/`}>{level.name}</a>}
</nav>
