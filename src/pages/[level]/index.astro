---
import { getCollection } from 'astro:content';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DoneBar from '../../components/DoneBar.astro';
import LevelProgress from '../../components/LevelProgress.astro';
import ResumeLink from '../../components/ResumeLink.astro';
import Layout from '../../layouts/Layout.astro';
import { levelLessons } from '../../lessons';
import { levels } from '../../levels';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return levels.filter((l) => l.published).map((level) => ({ params: { level: level.id }, props: { level, lessons: levelLessons(entries, level.id) } }));
}

const { level, lessons } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={level.name}>
  <Breadcrumb level={level} here />
  <h1>{level.name}</h1>
  <p>{level.boundary}</p>
  <LevelProgress level={level} lessons={lessons}>
    <DoneBar total={lessons.length} />
    <ResumeLink lessons={lessons} />
    <h2>レッスン一覧</h2>
    <ol class="space-y-2">
      {
        lessons.map((entry) => (
          <li>
            <div class="flex items-start justify-between gap-3">
              <div>
                <a href={`${base}/${entry.id}/`}>{entry.data.title}</a>
                <br />
                <span class="text-[.9rem] text-muted">{entry.data.goal}</span>
              </div>
              <span data-mark class="shrink-0 rounded-full border border-current px-2 text-[.9rem] text-progress-todo">未着手</span>
            </div>
          </li>
        ))
      }
    </ol>
  </LevelProgress>
</Layout>
